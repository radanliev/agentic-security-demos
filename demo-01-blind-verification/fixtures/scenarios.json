{
  "scenarios": [
    {
      "id": "authz-001",
      "task": "Fix authorization check in get_user_data endpoint",
      "context": "A support ticket reports that users can access other users' data by manipulating the user_id parameter.",
      "codebase": {
        "files": {
          "app/api/users.py": "def get_user_data(user_id: str, current_user: User):\n    # TODO: Add authorization check\n    return db.query(UserData).filter_by(user_id=user_id).first()"
        }
      },
      "hidden_oracle": {
        "type": "patch",
        "expected_fix": "if user_id != current_user.id:\n    raise AuthorizationError()",
        "test_cases": [
          {"input": {"user_id": "user-123", "current_user": {"id": "user-123"}}, "expect": "success"},
          {"input": {"user_id": "user-456", "current_user": {"id": "user-123"}}, "expect": "AuthorizationError"}
        ]
      }
    },
    {
